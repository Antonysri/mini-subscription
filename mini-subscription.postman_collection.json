		{
			"name": "4. Billing & Subscription Management",
			"item": [
				{
					"name": "Get Active Subscription Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/me/subscription",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"me",
								"subscription"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Paginated Payment History",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/me/payments?page=1&per_page=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"me",
								"payments"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "10"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Security & Rate Limiting Verification",
			"item": [
				{
					"name": "Verify OWASP Security Headers",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('X-Content-Type-Options is nosniff', function () {",
									"    pm.response.to.have.header('X-Content-Type-Options', 'nosniff');",
									"});",
									"pm.test('X-Frame-Options is DENY', function () {",
									"    pm.response.to.have.header('X-Frame-Options', 'DENY');",
									"});",
									"pm.test('X-XSS-Protection is 1; mode=block', function () {",
									"    pm.response.to.have.header('X-XSS-Protection', '1; mode=block');",
									"});",
									"pm.test('Strict-Transport-Security is present', function () {",
									"    pm.response.to.have.header('Strict-Transport-Security');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/plans",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"plans"
							]
						}
					},
					"response": []
				},
				{
					"name": "Test Unauthenticated 401 Envelope",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 401', function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"pm.test('Envelope has success=false', function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data.success).to.eql(false);",
									"    pm.expect(data.message).to.eql('Unauthenticated or token expired.');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"me"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "",
			"type": "string"
		}
	]
