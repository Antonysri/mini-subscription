# ==============================================================================
# Automated Testing Environment Configuration (.env.testing)
#
# ❓ INTHA FILE ENNA PANNUTHU?
# Tests run aagum pothu (Host machine-lo illana Docker kulla-yo):
# Ultra-fast in-memory SQLite, array cache, matrum sync queues use panna
# Laravel automatic-ah intha file-ah load pannum!
# ==============================================================================

APP_ENV=testing
APP_KEY=base64:BxITairwbnsxE8o9kEey7WFI+c7AisxfV8MPlzZg0/0=
APP_DEBUG=true

# 🚀 Ultra-Fast In-Memory Testing Database:
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# ⚡ In-Memory Cache & Session for Tests:
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# 💳 Dummy Stripe Testing Keys:
STRIPE_KEY=pk_test_dummy
STRIPE_SECRET=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
