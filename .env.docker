# ==============================================================================
# Docker Production Environment Variables
# 
# ❓ INTHA FILE ENNA PANNUTHU?
# Docker Compose-kulla run aagum pothu MySQL, Redis, JWT, Stripe keys-ai
# automatic-ah connect panna thevaiyana configurations.
# ==============================================================================

APP_NAME="Mini Subscription"
APP_ENV=production
APP_KEY=base64:BxITairwbnsxE8o9kEey7WFI+c7AisxfV8MPlzZg0/0=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 🗄️ DOCKER DATABASE CONFIGURATION (MySQL Service):
# Notice: Hostname '127.0.0.1' kidayathu, 'mysql' container name!
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mini_subscription
DB_USERNAME=root
DB_PASSWORD=secret_db_pass

SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# ⚡ DOCKER REDIS CONFIGURATION:
# Notice: Hostname '127.0.0.1' kidayathu, 'redis' container name!
# ------------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=mini_sub_cache
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

